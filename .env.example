# Required
DATABASE_URL=postgres://hookman:hookman_secret@localhost:5432/hookman
API_KEY=change-me-to-a-strong-random-key
SIGNING_SECRET=change-me-to-a-strong-random-secret

# Optional (defaults shown)
PORT=4000
WORKER_CONCURRENCY=20
MAX_RETRIES=5
REQUEST_TIMEOUT=10s
POLL_INTERVAL=1s
METRICS_ENABLED=false
LOG_LEVEL=info
DASHBOARD_ENABLED=true
